{
  "name": "@berenyilevente/bug-hunt",
  "version": "0.1.1",
  "description": "A dev overlay for marking bugs on a Next.js page and saving them as a report to a disposit board.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "default": "./dist/route.js"
    }
  },
  "bin": {
    "bug-hunt": "./setup/cli.mjs"
  },
  "files": [
    "dist",
    "setup/*.mjs"
  ],
  "scripts": {
    "build": "rm -rf dist && npm run build:css && tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles/overlay.css -o .css-build/overlay.css --minify && node scripts/embed-css.mjs",
    "test": "npm run build:css && vitest run",
    "typecheck": "npm run build:css && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "modern-screenshot": "^4.7.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "next": "^16.3.4",
    "prettier": "3.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
